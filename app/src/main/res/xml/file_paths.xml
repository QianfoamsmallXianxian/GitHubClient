<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- 下载后解压出来的 APK 放在 app 私有外部目录，供 FileProvider 暴露给安装器 -->
    <external-files-path name="apk" path="apk/" />
    <external-files-path name="downloads" path="downloads/" />
    <cache-path name="cache" path="." />
    <!-- 外部存储不可用时 getExternalFilesDir(null) 返回 null，兜底落到内部 filesDir/apk -->
    <files-path name="apk_internal" path="apk/" />
</paths>
